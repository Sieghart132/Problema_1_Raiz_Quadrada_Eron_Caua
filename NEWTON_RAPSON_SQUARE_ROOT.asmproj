
.INCLUDE "m328pdef.inc"

; =========================================================
; ENDERECOS ORIGINAIS DE SRAM
; =========================================================
.EQU QUOCIENTE_L   = 0x100
.EQU QUOCIENTE_H   = 0x101

.EQU VALOR_ATUAL_L = 0x102
.EQU VALOR_ATUAL_H = 0x103

.EQU RESTO_L       = 0x104
.EQU RESTO_H       = 0x105

.EQU VALOR_NOVO_L  = 0x106
.EQU VALOR_NOVO_H  = 0x107

; SRAM adicional para o radicando N * 100 (24 bits)
.EQU RADICANDO_0   = 0x108
.EQU RADICANDO_1   = 0x109
.EQU RADICANDO_2   = 0x10A

.EQU LEITURA       = 729


; =========================================================
; VETOR DE RESET
; =========================================================
.CSEG
.ORG 0x0000
    RJMP SETUP_NEWTON

; =========================================================
; CASO N = 0
; =========================================================
RAIZ_ZERO:

    CLR R16

    STS VALOR_ATUAL_L, R16
    STS VALOR_ATUAL_H, R16

    STS VALOR_NOVO_L, R16
    STS VALOR_NOVO_H, R16

    STS QUOCIENTE_L, R16
    STS QUOCIENTE_H, R16

    RJMP FIM_PARADO
; =========================================================
; INICIALIZACAO
; =========================================================
SETUP_NEWTON:

    ; Inicializa o stack pointer para permitir CALL e RET
    LDI R16, HIGH(RAMEND)
    OUT SPH, R16
    LDI R16, LOW(RAMEND)
    OUT SPL, R16

    ; Carrega N
    LDI R26, LOW(LEITURA)
    LDI R27, HIGH(LEITURA)

    ; Verifica N = 0
    MOV R16, R26
    OR  R16, R27
    BREQ RAIZ_ZERO

    ; -----------------------------------------------------
    ; Calcula RADICANDO = N * 100
    ; Resultado de 24 bits em R6:R5:R4
    ; -----------------------------------------------------
    CLR R4
    CLR R5
    CLR R6

    LDI R16, 100
    CLR R17

MULT_100:
    ADD R4, R26
    ADC R5, R27
    ADC R6, R17

    DEC R16
    BRNE MULT_100

    ; Salva N * 100 na SRAM
    STS RADICANDO_0, R4
    STS RADICANDO_1, R5
    STS RADICANDO_2, R6

    ; -----------------------------------------------------
    ; Palpite inicial X0 = 320
    ; sqrt(1023 * 100) < 320
    ; -----------------------------------------------------
    LDI R26, LOW(320)
    LDI R27, HIGH(320)

    STS VALOR_ATUAL_L, R26
    STS VALOR_ATUAL_H, R27


; =========================================================
; NEWTON
; Xnovo = (Xatual + RADICANDO / Xatual) / 2
; =========================================================
LOOP_NEWTON:

    CALL DIV

    ; Quociente retornado em R24:R23
    ; Carrega Xatual em R18:R19
    LDS R18, VALOR_ATUAL_L
    LDS R19, VALOR_ATUAL_H

    ; Soma Xatual + quociente
    ADD R23, R18
    ADC R24, R19

    ; Divide a soma por 2
    LSR R24
    ROR R23

    ; Compara Xnovo com Xatual
    CP  R23, R18
    CPC R24, R19

    ; Se Xnovo >= Xatual, Xatual e a raiz inteira
    BRSH FIM_NEWTON

    ; Atualiza Xatual = Xnovo
    STS VALOR_ATUAL_L, R23
    STS VALOR_ATUAL_H, R24

    RJMP LOOP_NEWTON


; =========================================================
; DIVISAO INTEIRA
;
; Dividendo: RADICANDO_2:RADICANDO_1:RADICANDO_0
; Divisor:   VALOR_ATUAL_H:VALOR_ATUAL_L
;
; Quociente: R24:R23 (16 bits)
; Resto:     R22:R21:R20 (24 bits)
;
; R17 deve permanecer zero durante a divisao.
; =========================================================
DIV:

    CLR R23
    CLR R24

    ; Carrega o dividendo de 24 bits
    LDS R20, RADICANDO_0
    LDS R21, RADICANDO_1
    LDS R22, RADICANDO_2

    ; Carrega o divisor de 16 bits
    LDS R18, VALOR_ATUAL_L
    LDS R19, VALOR_ATUAL_H

    CLR R17

    ; Protecao contra divisor zero
    MOV R16, R18
    OR  R16, R19
    BREQ DIV_ZERO


DIV_LOOP:

    ; Compara o resto de 24 bits com o divisor
    CP  R20, R18
    CPC R21, R19
    CPC R22, R17

    BRLO DIV_FIM

    ; Resto = resto - divisor
    SUB R20, R18
    SBC R21, R19
    SBC R22, R17

    ; Incrementa o quociente de 16 bits
    INC R23
    BRNE DIV_LOOP

    INC R24
    RJMP DIV_LOOP


DIV_FIM:

    ; Salva o quociente
    STS QUOCIENTE_L, R23
    STS QUOCIENTE_H, R24

    RET


DIV_ZERO:

    CLR R23
    CLR R24

    STS QUOCIENTE_L, R23
    STS QUOCIENTE_H, R24

    RET


; =========================================================
; RESULTADO FINAL
; VALOR_NOVO = floor(sqrt(N * 100))
; =========================================================
FIM_NEWTON:

    LDS R26, VALOR_ATUAL_L
    LDS R27, VALOR_ATUAL_H

    STS VALOR_NOVO_L, R26
    STS VALOR_NOVO_H, R27

    RJMP FIM_PARADO


; =========================================================
; PARADA
; =========================================================
FIM_PARADO:
    RJMP FIM_PARADO
